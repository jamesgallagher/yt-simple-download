# yt-simple-download — environment configuration
# Copy to .env for local runs. On Unraid these are set in the Docker template.
# NOTHING secret is committed to the repo; all secrets live here / in the template.

# --- Basic auth (defence-in-depth behind Cloudflare + Google SSO) -------------
# Both must be set to ENABLE basic auth. Leave EITHER blank/empty to DISABLE it.
APP_USER=admin
APP_PASSWORD=changeme

# --- Workers ------------------------------------------------------------------
# Number of concurrent download workers (clamped to 1-5).
WORKERS=1

# --- yt-dlp -------------------------------------------------------------------
# Self-update yt-dlp on container start (recommended; YouTube breaks it often).
AUTO_UPDATE=true

# Optional extra yt-dlp CLI args (advanced escape hatch), e.g. rate limits.
# EXTRA_YTDLP_ARGS=--limit-rate 5M

# --- Cookies (optional, per service) ------------------------------------------
# Most services need login cookies for some/most content. Export a Netscape
# cookies.txt from a browser logged into a THROWAWAY account (a cookies file
# grants full account access) and either point an env var at it, or drop files
# named <service>.txt into COOKIES_DIR (youtube.txt, facebook.txt, reddit.txt,
# x.txt, instagram.txt, tiktok.txt).
COOKIES_DIR=/config/cookies
# YT_COOKIES=/config/cookies/youtube.txt      # YouTube: age-restricted/members
# FB_COOKIES=/config/cookies/facebook.txt     # Facebook: private/gated videos
# REDDIT_COOKIES=/config/cookies/reddit.txt   # Reddit: NSFW/private subreddits
# X_COOKIES=/config/cookies/x.txt             # X: sensitive/age-restricted posts
# IG_COOKIES=/config/cookies/instagram.txt    # Instagram: usually REQUIRED
# TIKTOK_COOKIES=/config/cookies/tiktok.txt   # TikTok: region/age-gated only

# --- Storage (ephemeral) ------------------------------------------------------
# Temp working dir; purged on every container start. Finished files are served
# once to the browser, then swept after RETENTION_HOURS.
TMP_DIR=/downloads
RETENTION_HOURS=6

# --- Server -------------------------------------------------------------------
PORT=8080

# --- Redis (internal; usually leave as-is) ------------------------------------
# Redis is bound to 127.0.0.1 inside the container and never exposed.
# REDIS_PASSWORD=
# REDIS_PORT=6379
